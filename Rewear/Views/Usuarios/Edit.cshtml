@model Rewear.Models.Usuario

@{
    ViewData["Title"] = "Editar usuario";
}

<h1>Editar usuario</h1>

<h4>Usuario</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Nombres" class="control-label"></label>
                <input asp-for="Nombres" class="form-control" />
                <span asp-validation-for="Nombres" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Apellidos" class="control-label"></label>
                <input asp-for="Apellidos" class="form-control" />
                <span asp-validation-for="Apellidos" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Correo" class="control-label"></label>
                <input asp-for="Correo" class="form-control" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="Telefono" class="control-label"></label>
                <input asp-for="Telefono" class="form-control" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <!-- Foto de perfil -->
            <div class="form-group mt-3">
                <label class="control-label">Foto de perfil</label>

                @if (!string.IsNullOrEmpty(Model.FotoPerfil))
                {
                    <div class="mb-2">
                        <img src="@Model.FotoPerfil"
                             alt="Foto de perfil de @Model.Nombres"
                             style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%; border: 3px solid #ddd;" />
                    </div>
                }
                else
                {
                    <p>No tiene foto de perfil.</p>
                }

                <input type="file"
                       name="fotoPerfil"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" />

                <small class="text-muted">
                    Formatos permitidos: JPG, JPEG, PNG y WEBP. Máximo 5 MB.
                </small>

                <span asp-validation-for="FotoPerfil" class="text-danger"></span>
            </div>

            <!-- Contraseña -->
            <div class="form-group mt-3">
                <label class="control-label">Contraseña</label>
                <div>
                    <a asp-action="CambiarContrasena"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">
                        Cambiar contraseña
                    </a>
                </div>
            </div>

            <!-- Fecha de registro -->
            <div class="form-group mt-3">
                <label class="control-label">Fecha de registro</label>
                <input value="@Model.FechaRegistro.ToShortDateString()"
                       class="form-control"
                       readonly />
            </div>

            <!-- Estado -->
            <div class="form-group mt-3">
                <label class="control-label">Estado</label>
                <input value="@(Model.Estado ? "Activo" : "Inactivo")"
                       class="form-control"
                       readonly />
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-2">
    <a asp-action="Index">Volver a la lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}