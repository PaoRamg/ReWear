@model Rewear.Models.Usuario

@{
    ViewData["Title"] = "Detalle del usuario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/usuario-details.css" />
}

<div class="detalle-container">

    <div class="detalle-header">
        <h1>Detalle del usuario</h1>
        <p>Información del perfil</p>
    </div>

    <div class="usuario-card">

        <!-- Foto de perfil -->
        <div class="foto-container">

            @if (!string.IsNullOrEmpty(Model.FotoPerfil))
            {
                <img src="@Model.FotoPerfil"
                     alt="Foto de perfil de @Model.Nombres"
                     class="foto-perfil" />
            }
            else
            {
                <div class="foto-vacia">
                    Sin foto
                </div>
            }

        </div>

        <!-- Información del usuario -->
        <div class="datos-usuario">

            <div class="dato">
                <div class="dato-label">
                    Nombres
                </div>

                <div class="dato-valor">
                    @Model.Nombres
                </div>
            </div>

            <div class="dato">
                <div class="dato-label">
                    Apellidos
                </div>

                <div class="dato-valor">
                    @Model.Apellidos
                </div>
            </div>

            <div class="dato">
                <div class="dato-label">
                    Correo electrónico
                </div>

                <div class="dato-valor">
                    @Model.Correo
                </div>
            </div>

            <div class="dato">
                <div class="dato-label">
                    Teléfono
                </div>

                <div class="dato-valor">
                    @Model.Telefono
                </div>
            </div>

            <div class="dato">
                <div class="dato-label">
                    Fecha de registro
                </div>

                <div class="dato-valor">
                    @Model.FechaRegistro.ToShortDateString()
                </div>
            </div>

            <div class="dato">
                <div class="dato-label">
                    Estado
                </div>

                <div class="dato-valor">

                    @if (Model.Estado)
                    {
                        <span class="estado estado-activo">
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="estado estado-inactivo">
                            Inactivo
                        </span>
                    }

                </div>
            </div>

        </div>

        <!-- Acciones -->
        <div class="detalle-acciones">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn-detalle btn-editar-detalle">
                Editar usuario
            </a>

            <a asp-action="Index"
               class="btn-detalle btn-volver-detalle">
                Volver a usuarios
            </a>

        </div>

    </div>

</div>