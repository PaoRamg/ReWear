@model Rewear.Models.Usuario

@{
    ViewData["Title"] = "Detalle del usuario";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/usuario-form.css"
          asp-append-version="true" />
}

<div class="usuario-details-container">

    <div class="usuario-details-card">

        <!-- FOTO Y NOMBRE -->
        <div class="usuario-details-header">

            @if (!string.IsNullOrEmpty(Model.FotoPerfil))
            {
                <img src="@Model.FotoPerfil"
                     alt="Foto de perfil"
                     class="usuario-details-foto" />
            }
            else
            {
                <div class="usuario-details-foto usuario-sin-foto">
                    👤
                </div>
            }

            <h1>
                @Model.Nombres @Model.Apellidos
            </h1>

            <p>
                @Model.Correo
            </p>

        </div>


        <!-- INFORMACIÓN -->
        <div class="usuario-details-info">

            <div class="usuario-details-dato">
                <span>Nombres</span>
                <strong>@Model.Nombres</strong>
            </div>

            <div class="usuario-details-dato">
                <span>Apellidos</span>
                <strong>@Model.Apellidos</strong>
            </div>

            <div class="usuario-details-dato">
                <span>Correo electrónico</span>
                <strong>@Model.Correo</strong>
            </div>

            <div class="usuario-details-dato">
                <span>Teléfono</span>
                <strong>@Model.Telefono</strong>
            </div>

            <div class="usuario-details-dato">
                <span>Fecha de registro</span>
                <strong>
                    @Model.FechaRegistro.ToShortDateString()
                </strong>
            </div>

            <div class="usuario-details-dato">
                <span>Estado</span>

                @if (Model.Estado)
                {
                    <strong class="estado-activo">
                        ● Activo
                    </strong>
                }
                else
                {
                    <strong class="estado-inactivo">
                        ● Inactivo
                    </strong>
                }
            </div>

        </div>


        <!-- ACCIONES -->
        <div class="usuario-details-acciones">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn-guardar">
                Editar usuario
            </a>

            <a asp-action="Index"
               class="btn-cancelar">
                Volver a la lista
            </a>

        </div>

    </div>

</div>