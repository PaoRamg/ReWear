@model Rewear.Models.Usuario

@{
    ViewData["Title"] = "Eliminar usuario";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/usuario-form.css"
          asp-append-version="true" />
}

<div class="usuario-delete-container">

    <div class="usuario-delete-card">

        <div class="usuario-delete-header">

            <div class="usuario-delete-icon">
                ⚠
            </div>

            <h1>Eliminar usuario</h1>

            <p>
                ¿Está seguro de que desea eliminar este usuario?
            </p>

        </div>


        <div class="usuario-delete-info">

            <div class="dato-usuario">
                <span>Nombres</span>
                <strong>@Model.Nombres</strong>
            </div>

            <div class="dato-usuario">
                <span>Apellidos</span>
                <strong>@Model.Apellidos</strong>
            </div>

            <div class="dato-usuario">
                <span>Correo electrónico</span>
                <strong>@Model.Correo</strong>
            </div>

            <div class="dato-usuario">
                <span>Teléfono</span>
                <strong>@Model.Telefono</strong>
            </div>

            <div class="dato-usuario">
                <span>Fecha de registro</span>
                <strong>@Model.FechaRegistro.ToShortDateString()</strong>
            </div>

            <div class="dato-usuario">
                <span>Estado</span>
                <strong>
                    @(Model.Estado ? "Activo" : "Inactivo")
                </strong>
            </div>

        </div>


        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="usuario-delete-acciones">

                <button type="submit"
                        class="btn-eliminar-usuario">
                    Eliminar usuario
                </button>

                <a asp-action="Index"
                   class="btn-cancelar">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>