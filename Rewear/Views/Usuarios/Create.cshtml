@model Rewear.Models.Usuario

@{
    ViewData["Title"] = "Crear usuario";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/usuario-form.css"
          asp-append-version="true" />
}

<div class="usuario-form-container">

    <div class="usuario-form-header">
        <h1>Crear usuario</h1>
        <p>Registra un nuevo usuario en ReWear</p>
    </div>

    <div class="usuario-form-card">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <!-- Nombres -->
            <div class="usuario-campo">

                <label asp-for="Nombres"></label>

                <input asp-for="Nombres" />

                <span asp-validation-for="Nombres"
                      class="error-validacion">
                </span>

            </div>


            <!-- Apellidos -->
            <div class="usuario-campo">

                <label asp-for="Apellidos"></label>

                <input asp-for="Apellidos" />

                <span asp-validation-for="Apellidos"
                      class="error-validacion">
                </span>

            </div>


            <!-- Correo -->
            <div class="usuario-campo">

                <label asp-for="Correo"></label>

                <input asp-for="Correo" />

                <span asp-validation-for="Correo"
                      class="error-validacion">
                </span>

            </div>


            <!-- Contraseña -->
            <div class="usuario-campo">

                <label asp-for="Contrasena"></label>

                <input asp-for="Contrasena"
                       type="password" />

                <span asp-validation-for="Contrasena"
                      class="error-validacion">
                </span>

            </div>


            <!-- Teléfono -->
            <div class="usuario-campo">

                <label asp-for="Telefono"></label>

                <input asp-for="Telefono" />

                <span asp-validation-for="Telefono"
                      class="error-validacion">
                </span>

            </div>


            <!-- Foto de perfil -->
            <div class="usuario-campo">

                <label>Foto de perfil</label>

                <div class="foto-editar-container">

                    <img id="vistaPreviaFoto"
                         src=""
                         alt="Vista previa"
                         class="foto-editar"
                         style="display: none;" />

                    <p id="sinFoto"
                       class="sin-foto">
                        Puedes agregar una foto de perfil.
                    </p>

                </div>

                <input type="file"
                       name="fotoPerfil"
                       id="fotoPerfil"
                       accept=".jpg,.jpeg,.png,.webp" />

                <small class="texto-ayuda">
                    JPG, JPEG, PNG o WEBP. Máximo 5 MB.
                </small>

            </div>


            <!-- Acciones -->
            <div class="usuario-form-acciones">

                <button type="submit"
                        class="btn-guardar">
                    Crear usuario
                </button>

                <a asp-action="Index"
                   class="btn-cancelar">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>


<script>
    document.getElementById("fotoPerfil").addEventListener("change", function (event) {

        const archivo = event.target.files[0];

        if (archivo) {

            const vistaPrevia = document.getElementById("vistaPreviaFoto");
            const sinFoto = document.getElementById("sinFoto");

            vistaPrevia.src = URL.createObjectURL(archivo);
            vistaPrevia.style.display = "block";

            if (sinFoto) {
                sinFoto.style.display = "none";
            }
        }
    });
</script>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}